{
  "custom": {},
  "params": {
    "on": true,
    "speed": 80
  },
  "propConfig": {
    "params.on": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.speed": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 48,
      "width": 48
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "ObcPump"
        },
        "position": {
          "height": 48,
          "width": 48
        },
        "propConfig": {
          "props.on": {
            "binding": {
              "config": {
                "path": "view.params.on"
              },
              "type": "property"
            }
          },
          "props.speed": {
            "binding": {
              "config": {
                "path": "view.params.speed"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "hasSpeed": true
        },
        "type": "automation.pump.pump"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "classes": "utils/processComponent"
      }
    },
    "type": "ia.container.coord"
  }
}