{
  "custom": {
    "tag": "1000"
  },
  "params": {
    "readoutPosition": "bottom",
    "tagpath": "[default]process/valve0",
    "vertical": false
  },
  "propConfig": {
    "custom.tag": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagpath}"
          },
          "tagPath": "{1}/valveTag"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "params.readoutPosition": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagpath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.vertical": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 56,
      "width": 52
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "id": "sidemenu",
                "type": "open",
                "viewParams": {
                  "faceplateType": "valve",
                  "tagpath": "{view.params.tagpath}"
                }
              },
              "scope": "C",
              "type": "dock"
            }
          }
        },
        "meta": {
          "name": "DV"
        },
        "position": {
          "height": 48,
          "width": 48
        },
        "propConfig": {
          "props.activated": {
            "binding": {
              "config": {
                "expression": "{session.custom.hoverId}\u003d{view.params.tagpath}"
              },
              "type": "expr"
            }
          },
          "props.badgeControl": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "1": "{view.params.tagpath}"
                },
                "tagPath": "{1}/valveMode"
              },
              "transforms": [
                {
                  "fallback": "none",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": "local",
                      "output": "local"
                    },
                    {
                      "input": "manual",
                      "output": "manual"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "tag"
            }
          },
          "props.hasTag": {
            "binding": {
              "config": {
                "path": "session.custom.showTag"
              },
              "type": "property"
            }
          },
          "props.open": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "1": "{view.params.tagpath}"
                },
                "tagPath": "{1}/valveOpen"
              },
              "type": "tag"
            }
          },
          "props.readoutPosition": {
            "binding": {
              "config": {
                "path": "view.params.readoutPosition"
              },
              "type": "property"
            }
          },
          "props.showReadoutStack": {
            "binding": {
              "config": {
                "path": "session.custom.showReadout"
              },
              "type": "property"
            }
          },
          "props.tag": {
            "binding": {
              "config": {
                "path": "view.custom.tag"
              },
              "type": "property"
            }
          },
          "props.vertical": {
            "binding": {
              "config": {
                "path": "view.params.vertical"
              },
              "type": "property"
            }
          }
        },
        "type": "automation.digital-valve.digital-valve"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "classes": "utils/overflow-visible"
      }
    },
    "type": "ia.container.coord"
  }
}