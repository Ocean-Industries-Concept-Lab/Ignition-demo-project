{
  "custom": {
    "tag": "1000"
  },
  "params": {
    "readoutPosition": "bottom",
    "tagpath": "[default]process/valve0",
    "vertical": false,
    "showLabels": false
  },
  "propConfig": {
    "custom.tag": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagpath}"
          },
          "tagPath": "{1}/valveTag"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "params.readoutPosition": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagpath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.vertical": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.showLabels": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 40,
      "width": 40
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tsystem.perspective.sendMessage('deviceClicked', payload={'faceplateType': 'valve', 'tagpath': self.view.params.tagpath, 'x': event.clientX, 'y': event.clientY}, scope='page')"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "DV",
          "visible": false
        },
        "position": {
          "height": 40,
          "width": 40,
          "x": 4,
          "y": 4
        },
        "propConfig": {
          "props.activated": {
            "binding": {
              "config": {
                "expression": "{session.custom.hoverId}={view.params.tagpath}"
              },
              "type": "expr"
            }
          },
          "props.badgeControl": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "1": "{view.params.tagpath}"
                },
                "tagPath": "{1}/valveMode"
              },
              "transforms": [
                {
                  "fallback": "none",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": "local",
                      "output": "local"
                    },
                    {
                      "input": "manual",
                      "output": "manual"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "tag"
            }
          },
          "props.hasTag": {
            "binding": {
              "config": {
                "expression": "{view.params.showLabels} || {session.custom.showTag}"
              },
              "type": "expr"
            }
          },
          "props.open": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "1": "{view.params.tagpath}"
                },
                "tagPath": "{1}/valveOpen"
              },
              "type": "tag"
            }
          },
          "props.readoutPosition": {
            "binding": {
              "config": {
                "path": "view.params.readoutPosition"
              },
              "type": "property"
            }
          },
          "props.showReadoutStack": {
            "binding": {
              "config": {
                "expression": "{view.params.showLabels} || {session.custom.showReadout} || {session.custom.showTag}"
              },
              "type": "expr"
            }
          },
          "props.showStatus": {
            "binding": {
              "config": {
                "expression": "{view.params.showLabels} || {session.custom.showReadout}"
              },
              "type": "expr"
            }
          },
          "props.tag": {
            "binding": {
              "config": {
                "path": "view.custom.tag"
              },
              "type": "property"
            }
          },
          "props.vertical": {
            "binding": {
              "config": {
                "path": "view.params.vertical"
              },
              "type": "property"
            }
          },
          "meta.visible": {
            "binding": {
              "config": {
                "expression": "!isNull({this.props.open})"
              },
              "type": "expr"
            }
          }
        },
        "type": "automation.digital-valve.digital-valve"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "backgroundColor": "#C0C0C000",
        "classes": "utils/overflow-visible"
      }
    },
    "type": "ia.container.coord"
  }
}