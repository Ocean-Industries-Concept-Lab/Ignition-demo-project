      "persistent": true
    },
    "params.hasSpeed": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.on": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.readoutPosition": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.speed": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.speedUnit": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tag": {
      "paramDirection": "input",
