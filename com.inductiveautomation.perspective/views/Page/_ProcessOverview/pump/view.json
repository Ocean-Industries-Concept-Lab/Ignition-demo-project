              },
              "type": "expr"
            }
          },
          "props.componentSize": {
            "binding": {
              "config": {
                "path": "view.params.componentSize"
              },
              "type": "property"
            }
          },
          "props.direction": {
            "binding": {
              "config": {
                "path": "view.params.direction"
              },
              "type": "property"
            }
          },
          "props.hasSpeed": {
            "binding": {
              "config": {
                "path": "view.params.hasSpeed"
              },
              "type": "property"
            }
          },
          "props.on": {
            "binding": {
              "config": {
                "path": "view.params.on"
              },
              "type": "property"
            }
          },
          "props.readoutPosition": {
            "binding": {
              "config": {
                "path": "view.params.readoutPosition"
              },
              "type": "property"
            }
          },
          "props.speed": {
            "binding": {
              "config": {
                "path": "view.params.speed"
              },
              "type": "property"
            }
          },
          "props.speedUnit": {
            "binding": {
              "config": {
                "path": "view.params.speedUnit"
              },
              "type": "property"
            }
          },
          "props.tag": {
            "binding": {
              "config": {
                "expression": "{view.params.tag}"
              },
              "type": "expr"
