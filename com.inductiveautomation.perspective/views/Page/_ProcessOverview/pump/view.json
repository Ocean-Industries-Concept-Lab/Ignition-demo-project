{
  "custom": {
    "tag": 2010
  },
  "params": {
    "readoutPosition": "bottom",
    "tagpath": "[default]process/pump0"
  },
  "propConfig": {
    "custom.tag": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagpath}"
          },
          "tagPath": "{1}/pumpTag"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "params.readoutPosition": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagpath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 56,
      "width": 52
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "id": "sidemenu",
                "type": "open",
                "viewParams": {
                  "faceplateType": "pump",
                  "tagpath": "{view.params.tagpath}"
                }
              },
              "scope": "C",
              "type": "dock"
            }
          }
        },
        "meta": {
          "name": "PU2013"
        },
        "position": {
          "height": 48,
          "width": 48
        },
        "propConfig": {
          "props.activated": {
            "binding": {
              "config": {
                "expression": "{session.custom.hoverId}\u003d{view.params.tagpath}"
              },
              "type": "expr"
            }
          },
          "props.badgeControl": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "1": "{view.params.tagpath}"
                },
                "tagPath": "{1}/pumpMode"
              },
              "transforms": [
                {
                  "fallback": "none",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": "local",
                      "output": "local"
                    },
                    {
                      "input": "manual",
                      "output": "manual"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "tag"
            }
          },
          "props.direction": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "tagpath": "{view.params.tagpath}"
                },
                "tagPath": "{tagpath}/pumpOn"
              },
              "transforms": [
                {
                  "fallback": "forward-stopped",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": true,
                      "output": "forward"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "tag"
            }
          },
          "props.on": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "1": "{view.params.tagpath}"
                },
                "tagPath": "{1}/pumpOn"
              },
              "type": "tag"
            }
          },
          "props.readoutPosition": {
            "binding": {
              "config": {
                "path": "view.params.readoutPosition"
              },
              "type": "property"
            }
          },
          "props.speed": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "1": "{view.params.tagpath}"
                },
                "tagPath": "{1}/pumpSpeed"
              },
              "type": "tag"
            }
          },
          "props.tag": {
            "binding": {
              "config": {
                "path": "view.custom.tag"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "componentSize": "medium",
          "hasSpeed": true,
          "hasTag": true,
          "speedUnit": "%",
          "variant": "double"
        },
        "type": "automation.pump.pump"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "classes": "utils/overflow-visible"
      }
    },
    "type": "ia.container.coord"
  }
}