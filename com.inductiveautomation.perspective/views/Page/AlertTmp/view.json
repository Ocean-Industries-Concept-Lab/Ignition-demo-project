{
  "custom": {},
  "params": {
    "alarmId": null
  },
  "propConfig": {
    "params.alarmId": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {},
  "root": {
    "children": [
      {
        "events": {
          "component": {
            "onItemClick": {
              "config": {
                "script": "\tself.view.params.alarmId \u003d event.alarmId"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "alertList"
        },
        "position": {
          "basis": "400px",
          "grow": 1
        },
        "props": {
          "style": {
            "overflow": "auto"
          }
        },
        "type": "openbridge.manual.alert-list"
      },
      {
        "meta": {
          "name": "alertDetail"
        },
        "position": {
          "basis": "360px",
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.params.alarmId}!\u003dnull \u0026\u0026 {view.params.alarmId}!\u003d\"null\""
              },
              "type": "expr"
            }
          },
          "props.eventId": {
            "binding": {
              "config": {
                "path": "view.params.alarmId"
              },
              "type": "property"
            }
          }
        },
        "type": "openbridge.manual.alert-detail"
      }
    ],
    "meta": {
      "name": "root"
    },
    "type": "ia.container.flex"
  }
}