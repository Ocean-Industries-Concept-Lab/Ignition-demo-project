{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 796,
      "width": 320
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "navbar"
        },
        "position": {
          "basis": "160px"
        },
        "propConfig": {
          "props.companyImageUrl": {
            "binding": {
              "config": {
                "expression": "\"/system/images/Logo/\"+{session.custom.palette}+\".svg\""
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "alertListPageName": "Page/Alarms",
          "companyImageAlt": "OpenStudio logo",
          "companyUrl": "https://openstudio.no",
          "footerItems": [
            {
              "alerts": {},
              "children": [],
              "icon": {
                "path": "openbridge/support-google"
              },
              "label": "Help",
              "path": "http://docs.openstudio.no"
            }
          ],
          "items": [
            {
              "icon": "home",
              "label": "Process overview",
              "path": "/"
            },
            {
              "icon": "dashboard",
              "label": "Dashboard",
              "path": "/card"
            },
            {
              "children": [
                {
                  "icon": "",
                  "label": "sub",
                  "path": ""
                },
                {
                  "children": [
                    {
                      "icon": "",
                      "label": "subsub",
                      "path": ""
                    }
                  ],
                  "icon": "",
                  "label": "sub group",
                  "path": ""
                }
              ],
              "icon": "command-shared",
              "label": "Group",
              "path": ""
            },
            {
              "icon": "input-devices-google",
              "label": "UI components",
              "path": "/maritime"
            }
          ]
        },
        "type": "openbridge.manual.navbar"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "classes": "Menu/Menu",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}